# Called when the node enters the scene tree for the first time.
func _ready():
	%Sprite2D.texture = level_info.get(current_level_name).get("background")
	$AudioStreamPlayer2D.stream = level_info.get(current_level_name).get("music")
	
	if in_edit_mode:
		RhythmGameSignals.KeyListenerPress.connect(KeyListenerPress)
		$AudioStreamPlayer2D.play()
	else:
		var fk_times = level_info.get(current_level_name).get("fk_times")
		var fk_times_arr = str_to_var(fk_times)
		print(fk_times_arr[0])
		
		var counter: int = 0
		for key in fk_times_arr:
			
			var button_name: String = ""
			match counter:
				0:
					button_name = "button_Q"
				1:
					button_name = "button_W"
				2:
					button_name = "button_E"
				3:
					button_name = "button_R"
			
			for time in key:
				spawn_queue.append({"time": time, "button": button_name})
			
			counter += 1
		
		# sort all spawn entries by time so we can step through them in order
		spawn_queue.sort_custom(func(a, b): return a["time"] < b["time"])
		
		$AudioStreamPlayer2D.play()
 
func _process(delta):
	if in_edit_mode:
		return
	
	if spawn_index >= spawn_queue.size():
		return
	
	var playback_pos = $AudioStreamPlayer2D.get_playback_position()
	
	while spawn_index < spawn_queue.size() and playback_pos + sync_offset >= spawn_queue[spawn_index]["time"]:
		RhythmGameSignals.CreateFallingKey.emit(spawn_queue[spawn_index]["button"])
		spawn_index += 1
 
func KeyListenerPress(button_name: String, array_num: int):
	print(str(array_num) + " " + str($AudioStreamPlayer2D.get_playback_position()))
	fk_output_arr[array_num].append($AudioStreamPlayer2D.get_playback_position() - fk_fall_time)
 
 
func _on_audio_stream_player_2d_finished():
	print(fk_output_arr)
	get_tree().change_scene_to_file("res://Scenes/rhythm game/rhythm_result_screen_glungus.tscn")
 
